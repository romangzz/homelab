{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "kubernetes": {
    "managerFilePatterns": ["/^apps\\/.+\\.ya?ml$/"]
  },
  "argocd": {
    "managerFilePatterns": [
      "/^apps\\/argocd-apps\\/.+\\.yaml$/",
      "/^apps\\/monitoring\\/(stack|loki)\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": ["kubernetes"],
      "commitMessagePrefix": "chore(deps):",
      "addLabels": ["kubernetes"]
    },
    {
      "matchManagers": ["argocd"],
      "commitMessagePrefix": "chore(deps):",
      "addLabels": ["helm"]
    },
    {
      "matchManagers": ["argocd"],
      "matchPackageNames": ["plane-ce"],
      "prBodyNotes": [
        "After merging: run `kubectl -n plane delete job plane-api-migrate-1` so ArgoCD recreates the migrator Job with the new image (see the ignoreDifferences comment in apps/argocd-apps/plane.yaml)."
      ]
    }
  ]
}
